{
    "name": "mbiakova/laravel-distributable",
    "description": "Laravel modules built as independently deployable microservices: each owns its data, and they talk through events and RPC. Run them as one app, or split them apart whenever you want.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "modular-monolith",
        "distributable",
        "modules",
        "microservices",
        "events",
        "outbox"
    ],
    "authors": [
        {
            "name": "Josias Mekontso",
            "email": "josiasmekontso.it@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "mbiakova/laravel-microservices": "^0.1"
    },
    "repositories": {
        "microservices": {
            "type": "path",
            "url": "../laravel-microservices",
            "options": {
                "symlink": true,
                "versions": {
                    "mbiakova/laravel-microservices": "0.1.0"
                }
            }
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/octane": "^2.20",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "suggest": {
        "laravel/octane": "High-throughput application server; the kernel also runs under plain FPM"
    },
    "autoload": {
        "psr-4": {
            "Distributable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Distributable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Distributable\\Providers\\DistributableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "pint --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
